<?xml version="1.0" encoding="UTF-8"?>                  <!-- prolog mit xml version & zeichenkodierung des docs -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">             <!-- Vorlage für Dokumente aus dem targetNamespace,
                                                             InstanzDocs müssen sich an Struktur und Typen des schemas halten -->

    <!-- Abstrakte Definition, besteht aus einem Namen und Liste von Terminen, dient als Basis für instanziierbare Kalender -->
    <!-- complexType: made of several elements -->
    <xs:complexType name = "Kalender" abstract="true">   <!-- abstract verhindert direkte Instanziierung -->
        <xs:sequence>            <!-- sequence legt Reihenfolge der elemente fest und verhindert zusätzliche elemente -->
            <xs:element name="Name" type="xs:string"/>
            <xs:element name="Termine">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="Termin" type="Termin" maxOccurs="unbounded"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- complexType legt struktur und reihenfolge der attribute und kindelemente fest -->

    <!-- Wurzelelement Kalender, kann entweder Raum-, Personen- oder Gruppenkalender sein -->
    <xs:element name="Kalender">    <!-- simpleType kann nur textcontent enthalten, keine attribute oder kindelemente -->
        <xs:complexType>            <!-- complexType kann attribute, elemente oder oder einen mix davon enthalten -->
            <xs:choice>             <!-- choice beschränkt auf einen einzigen KalenderTyp innerhalb von Kalender -->
                <xs:element name="RaumKalender" type="RaumKalender"/>
                <xs:element name="PersonenKalender" type="PersonenKalender"/>
                <xs:element name="GruppenKalender" type="GruppenKalender"/>
            </xs:choice>
        </xs:complexType>
    </xs:element>


    <!-- Definition RaumKalender, erweitert abstrakten KalenderTyp um das Element Plätze -->
    <xs:complexType name="RaumKalender">
        <xs:complexContent>     <!-- complexContent: Raumkalender extends Kalender und erbt alle elemente und attribute -->
            <xs:extension base="Kalender">
                <xs:sequence>
                    <xs:element name="Plaetze" type="xs:int"/>
                </xs:sequence>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>


    <!-- Definition PersonenKalender, erweitert abstrakten KalenderTyp um das Element Besitzer -->
    <xs:complexType name="PersonenKalender">
        <xs:complexContent>
            <xs:extension base="Kalender">
                <xs:sequence>
                    <xs:element name="Besitzer" type="xs:string"/>
                </xs:sequence>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>


    <!-- Definition GruppenKalender, erweitert abstrakten KalenderTyp um eine Liste von bis zu 10 Mitglied-Elementen -->
    <xs:complexType name="GruppenKalender">
        <xs:complexContent>
            <xs:extension base="Kalender">
                <xs:sequence>
                    <xs:element name="Mitglieder">
                        <xs:complexType>
                            <xs:sequence>
                                <xs:element name="Mitglied" type="xs:string" maxOccurs="10"/>
                            </xs:sequence>
                        </xs:complexType>
                    </xs:element>
                </xs:sequence>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>


    <!-- Definition Termin -->
    <xs:complexType name="Termin">
        <xs:sequence>
            <xs:element name="Name" type="xs:string"/>
            <xs:element name="Start" type="xs:dateTime"/>
            <xs:element name="Ende" type="xs:dateTime"/>
        </xs:sequence>
    </xs:complexType>
</xs:schema>